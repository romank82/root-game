[Unit]
Description=ROOT Game database backup (daily pg_dump)
Documentation=file:/opt/root-game/deploy/README.md
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
# На этом сервере нет непривилегированного пользователя: каталог /opt/root-game
# принадлежит root и основной сервис root-game тоже работает от root. Юнит без
# User= запустится от root — так же, как всё остальное на машине. Переход на
# отдельного пользователя (deployer) — отдельная задача: он требует chown
# каталога, venv, dist, .env и прав в PostgreSQL, иначе прод сломается.
# Каталог бэкапов создаётся заранее:
#   install -d -m 700 /var/backups/root-game
Environment=BACKUP_DIR=/var/backups/root-game
Environment=KEEP_DAYS=14
ExecStart=/bin/sh /opt/root-game/deploy/backup-db.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal

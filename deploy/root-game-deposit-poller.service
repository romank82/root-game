[Unit]
Description=ROOT Game Deposit Poller (Jetton ROOT deposits)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# На этом сервере нет непривилегированного пользователя: каталог /opt/root-game
# принадлежит root и основной сервис root-game тоже работает от root. Юнит без
# User= запустится от root — как и всё остальное на машине. Переход на
# отдельного пользователя — отдельная задача (chown каталога, venv, dist, .env
# и права в PostgreSQL), иначе прод сломается в момент переключения.
WorkingDirectory=/opt/root-game/backend
EnvironmentFile=/opt/root-game/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/root-game/backend/venv/bin/python -m app.deposit_poller
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=ROOT Game Deposit Poller (Jetton ROOT deposits)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# Работает от deployer, как и основной сервис: суперпользователь не нужен,
# поллеру достаточно прав на каталог /opt/root-game/backend и на БД.
User=deployer
Group=deployer
WorkingDirectory=/opt/root-game/backend
EnvironmentFile=/opt/root-game/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/root-game/backend/venv/bin/python -m app.deposit_poller
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

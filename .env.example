# Docker Compose / PostgreSQL
POSTGRES_DB=chimera
POSTGRES_USER=chimera
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Public Nginx port on the host machine.
APP_PORT=8080

# Needed only for browser clients calling FastAPI directly, not via Nginx /api.
CORS_ORIGINS=http://localhost

# Telegram Mini App authentication
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_BOT_USERNAME=HimeraProtocolBot
TELEGRAM_INITDATA_MAX_AGE_SECONDS=3600

# Секрет webhook Telegram (пусто — dev-режим без проверки заголовка).
TELEGRAM_WEBHOOK_SECRET=

# Generate a long random value; never commit the real secret.
GAME_SESSION_SECRET=replace-with-a-long-random-session-secret
GAME_SESSION_LIFETIME_SECONDS=86400

# Application environment: development / staging / production.
APP_ENV=development

# Database (PostgreSQL in Docker; local default: omit to use backend/chimera.db).
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5433/chimera_test

# Admin session lifetime (seconds).
ADMIN_SESSION_LIFETIME_SECONDS=86400

# TON (testnet): mnemonic of payout wallet, network, API, Jetton master.
TON_PAYOUT_MNEMONIC=
TON_NETWORK=testnet
TON_API_ENDPOINT=
TON_ROOT_JETTON_MASTER=

# Sentry/GlitchTip (empty = no-op).
SENTRY_DSN=
#SENTRY_ENVIRONMENT=
#SENTRY_TRACES_SAMPLE_RATE=0
#SENTRY_RELEASE=

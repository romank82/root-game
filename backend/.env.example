# Application environment: development, staging or production.
APP_ENV=development

# Local default: omit DATABASE_URL to use backend/chimera.db automatically.
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://chimera:CHANGE_ME@db:5432/chimera

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TON (testnet): мнемоника «спец» кошелька (12 слов через пробел).
TON_PAYOUT_MNEMONIC=
TON_NETWORK=testnet
TON_API_ENDPOINT=
# Адрес минтера ROOT (Jetton master) для Jetton transfer.
TON_ROOT_JETTON_MASTER=

# Sentry/GlitchTip (Sprint 13.6): внешний мониторинг ошибок.
# Оставьте пустым — Sentry не инициализируется (no-op), игра работает как обычно.
# При поднятом GlitchTip/Sentry укажите DSN в backend/.env (НЕ коммитить).
SENTRY_DSN=

# Окружение для Sentry: development / staging / production.
# По умолчанию берётся из APP_ENV.
#SENTRY_ENVIRONMENT=

# Доля транзакций для performance-tracing: 0.0 (выкл) … 1.0 (все). По умолчанию 0.
#SENTRY_TRACES_SAMPLE_RATE=0.0

# Релиз/версия для Sentry (необязательно). По умолчанию пусто.
#SENTRY_RELEASE=
